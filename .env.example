# Copy this file to .env and fill in your values.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# --- Publication identity -------------------------------------------------
SITE_NAME=PulseWire
SITE_TAGLINE=Today's hot topics, responsibly summarised
SITE_BASE_URL=http://127.0.0.1:8000

# --- Search (required) ----------------------------------------------------
# Get a key at https://app.tavily.com
TAVILY_API_KEY=

# --- Local model (must stay under 4 GB) -----------------------------------
# llama3.2 is ~2.0 GB. Alternatives: qwen2.5:3b (~1.9 GB), phi3.5 (~2.2 GB),
# gemma2:2b (~1.6 GB). Pull one with: ollama pull llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=300
OLLAMA_NUM_CTX=8192

# --- Volume ---------------------------------------------------------------
DAILY_ARTICLE_TARGET=20
TOPIC_CANDIDATE_POOL=60
SOURCES_PER_TOPIC=5
MIN_SOURCES_FOR_RUMOUR=2

# --- Originality thresholds ----------------------------------------------
# Fraction of the draft's 5-word sequences allowed to match a source.
MAX_NGRAM_OVERLAP=0.12
# Longest run of identical consecutive words allowed.
MAX_LONGEST_COMMON_RUN=9
ORIGINALITY_NGRAM_SIZE=5
MAX_REWRITE_ATTEMPTS=3

# --- Article length -------------------------------------------------------
# The writer builds the article in three passes to reach full length, because a
# small model cannot hold a long article in one response.
MIN_ARTICLE_WORDS=420
MAX_ARTICLE_WORDS=900
TARGET_ARTICLE_WORDS=600

# Characters of source text fed to the fact extractor per article. Full-text
# extraction is what makes a long article possible; snippets are far too thin.
SOURCE_TEXT_BUDGET=24000
USE_FULL_TEXT_EXTRACTION=1

# --- Images ---------------------------------------------------------------
# Only openly-licensed images (Openverse, Wikimedia Commons) are downloaded and
# stored locally. Never the source outlets' own photography, which is
# agency-licensed and cannot lawfully be republished.
FETCH_IMAGES=1
IMAGE_MAX_WIDTH=1280
IMAGE_JPEG_QUALITY=82

# --- Retention ------------------------------------------------------------
# Stories nobody read are deleted after this many days, with their images.
RETENTION_DAYS=7
RETENTION_MIN_VIEWS=5
RETENTION_KEEP_REVIEWED=1

# --- Publishing behaviour -------------------------------------------------
# 0 = every article waits for a human in the admin review queue.
AUTO_PUBLISH=1

# --- Scheduler (used by `manage.py run_scheduler`) ------------------------
SCHEDULE_HOUR=6
SCHEDULE_MINUTE=30

LOG_LEVEL=INFO
